# Application
APP_NAME=SkillCubes API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security — change these in production
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database
# SQLite (default for local Flutter / mobile backend testing):
DATABASE_URL=sqlite+aiosqlite:///./skillcubes.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillcubes

# CORS — Flutter web / emulator / local
CORS_ORIGINS=["*"]

# Gemini — SkillCubes AI Cognitive Coach
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
